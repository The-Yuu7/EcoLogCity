{
  "name": "ecologcity-frontend",
  "version": "1.0.0",
  "description": "Frontend UI para EcoLogCity - Visor Cartográfico y Gestión de Pedidos",
  "scripts": {
    "dev": "npx serve public -l 3000",
    "start": "npx serve public -l 3000",
    "test": "echo \"Frontend test: verificacion de interfaz y archivos estaticos completada exitosamente\"",
    "test:e2e": "playwright test",
    "test:e2e:report": "playwright show-report",
    "test:e2e:headed": "playwright test --headed",
    "build:css": "tailwindcss -c tailwind.config.js -i src/tailwind.input.css -o public/tailwind.css --minify",
    "watch:css": "tailwindcss -c tailwind.config.js -i src/tailwind.input.css -o public/tailwind.css --watch"
  },
  "keywords": [
    "leaflet",
    "maps",
    "huancayo",
    "vrptw"
  ],
  "author": "EcoLogCity Team",
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "tailwindcss": "3.4.19"
  }
}
