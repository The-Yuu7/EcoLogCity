# ==============================================================================
# EcoLogCity - Plantilla de Variables de Entorno (.env.example)
# ==============================================================================
# NOTA DE SEGURIDAD:
# Este archivo es solo una plantilla referencial.
# NUNCA ingresar claves de producción, contraseñas o API keys reales en este archivo.
# Copie este archivo a '.env' para su configuración local.
# ==============================================================================

# Configuración General del Servidor / Backend
PORT=8000
NODE_ENV=development
APP_NAME=EcoLogCity
API_BASE_URL=http://localhost:8000/api/v1
CORS_ORIGIN=http://localhost:3000

# Configuración de Base de Datos (PostgreSQL + PostGIS)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ecologcity_db
DB_USER=postgres
DB_PASSWORD=your_secure_password_here

# Configuración de Autenticación / Seguridad
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=24h

# Servicios de Mapas y Tráfico (API Keys)
MAPBOX_ACCESS_TOKEN=your_mapbox_token_here
GOOGLE_MAPS_API_KEY=your_google_maps_key_here
WAZE_CCP_API_KEY=your_waze_api_key_here

# Configuraciones de Costos y Emisiones para Huancayo
FUEL_COST_PER_GALLON_PEN=17.50
MAINTENANCE_COST_PER_KM_PEN=1.20
CO2_EMISSION_FACTOR_DIESEL_KG_KM=2.68
ALTITUDE_M_ABOVE_SEA_LEVEL=3250
