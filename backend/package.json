{
  "name": "ecologcity-backend",
  "version": "1.0.0",
  "description": "Backend API para EcoLogCity - Plataforma de Optimización de Rutas Sostenibles Huancayo",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:init": "node src/scripts/initDb.js",
    "test": "jest --detectOpenHandles --forceExit --runInBand",
    "test:coverage": "jest --coverage --detectOpenHandles --forceExit --runInBand"
  },
  "keywords": [
    "vrptw",
    "green-vrp",
    "huancayo",
    "logistics",
    "sustainability",
    "postgis"
  ],
  "author": "EcoLogCity Team",
  "license": "ISC",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "pg": "^8.13.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "coveragePathIgnorePatterns": [
      "/node_modules/"
    ]
  }
}
