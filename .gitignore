# =============================================================================
# EcoLogCity .gitignore — Sprint 3 (Ítem 6 y Rúbrica Oficial)
# =============================================================================

# --- Dependencias de Node.js ---
node_modules/
jspm_packages/
web_drivers/

# --- Salidas de Build y Cobertura (Jest / SonarQube) ---
dist/
build/
out/
coverage/
backend/coverage/
.next/
.nuxt/
.cache/
*.lcov
lcov.info

# --- Logs de Debug ---
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.log

# --- Python (entornos virtuales, caches y scripts temporales) ---
__pycache__/
*.py[cod]
*$py.class
.Python
env/
venv/
.venv/
pip-log.txt
pip-delete-this-directory.txt
.tox/
.coverage
nosetests.xml
coverage.xml
*.cover
.pytest_cache/
.mypy_cache/
.poetry/
*.py

# --- Sistema Operativo y Archivos Temporales ---
.DS_Store
Thumbs.db
desktop.ini
*.tmp
*.bak
*.swp
*.sw?
*~

# --- IDEs y Editores ---
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln

# --- Variables de Entorno (Credenciales y Secretos) ---
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env

# --- Archivos temporales y de backup de Git ---
*.gitignore~
.gitignore.bak
*.orig

# --- Archivos de Consigna / Guías de Estudio / Documentos de Evaluación ---
# (Excluidos del repositorio oficial según rúbrica e instrucciones del curso)
Consigna*.html
Guia*.html
Rubrica*.html
*.docx

# --- Base de Datos Local ---
/db_data/
/pgdata/
